# Password for the single-user gate (min. 8 characters).
APP_PASSWORD=change-me-please

# Supabase project (Project Settings -> API Keys).
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only key. Use the "secret" key (sb_secret_...) or the legacy service_role key.
# Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Google Sheets meal library (server-only). Optional in development: without
# GOOGLE_SHEETS_SPREADSHEET_ID the Meals screen shows a small fixture dataset instead.
GOOGLE_SHEETS_SPREADSHEET_ID=10-ncMSZQxVM7n93-F2cPl2vQWz0atXexrzKieQAE1sI
GOOGLE_SHEETS_TARGET_GID=965578947

# Default (no extra setup): share the spreadsheet as "Anyone with the link — Viewer"
# and stop here. The app reads it over the public CSV export, no credentials needed.

# Optional, for a private (not link-shared) spreadsheet: a Google service account.
# When both are set, the app authenticates instead of using the public export, and
# can also resolve the tab's display name. Share the spreadsheet with this email
# as Viewer.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=mealprep@your-project.iam.gserviceaccount.com
# Paste the private_key from the service-account JSON on one line, keeping the \n sequences.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Optional: natural-language food estimation ("Kebab z kurczakiem, ok. 900 kcal").
# Without it the app works fully; the estimate option simply does not appear.
# ANTHROPIC_API_KEY=sk-ant-...
