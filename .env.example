# ============================================================================
# PRIVATE — server only. Never prefix these with NEXT_PUBLIC_, never commit
# real values. Anything with NEXT_PUBLIC_ is compiled into the browser bundle
# and is readable by anyone who opens the app.
# ============================================================================

# Password for the single-user gate. Minimum 8 characters.
APP_PASSWORD=

# Signs the session cookie. Any long random string; generate one with:
#   openssl rand -base64 32
# Optional: falls back to APP_PASSWORD when unset. Changing it logs out every device.
SESSION_SECRET=

# Supabase server key. Project Settings -> API Keys -> "service_role" (or the
# newer "secret" key, sb_secret_...). Full database access: server only.
SUPABASE_SERVICE_ROLE_KEY=

# Google service account that reads the meal sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste private_key from the service-account JSON on ONE line, keeping the \n
# sequences exactly as they appear. Surrounding quotes are fine.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional: natural-language food estimation ("Kebab z kurczakiem, ok. 900 kcal").
# Leave empty and the app works fully; the estimate option simply does not appear.
ANTHROPIC_API_KEY=


# ============================================================================
# PUBLIC — safe to expose in the browser.
# ============================================================================

# Supabase project URL. Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Not currently used: this app has no browser database
# client by design, all queries run server-side. Safe to leave empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the deployed URL, e.g. https://mealprep.vercel.app
NEXT_PUBLIC_APP_URL=


# ============================================================================
# MEAL LIBRARY — not secret, but read server-side only.
# ============================================================================

# Either the id or the full sheet URL; the id is extracted from a URL.
GOOGLE_SHEETS_SPREADSHEET_ID=10-ncMSZQxVM7n93-F2cPl2vQWz0atXexrzKieQAE1sI

# Optional. Defaults to the meal-library tab. Set it only if that table moves
# to another tab: open the tab and copy the gid from the URL (a full URL works).
GOOGLE_SHEETS_TARGET_GID=894227705

# Two ways to let the app read that sheet, pick one:
#   1. Share it as "Anyone with the link — Viewer". Nothing else needed.
#   2. Share it with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer and set the two
#      GOOGLE_SERVICE_ACCOUNT_* values above. Use this to keep the sheet private.


# ============================================================================
# GROCERY DATA SOURCES — server only, all optional. See docs/grocery/.
# ============================================================================

# Price sources with no permission on record (lidl.pl, Blix, Biedronka and
# Auchan online, Stokrotka's feed) are NOT read unless this is "on". Turn it on
# only for private use; their prices stay labelled unverified.
GROCERY_UNVERIFIED_SOURCES=

# Contact (e-mail or URL) for the User-Agent Open Food Facts asks apps to send.
OPEN_FOOD_FACTS_CONTACT=

# GS1 Polska eProdukty is not wired; this is only reported as present or not.
GS1_EPRODUKTY_API_KEY=
